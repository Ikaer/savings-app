{
  "name": "savings-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -k --kill-signal SIGKILL -n next,css -c cyan,magenta \"npm run dev:next\" \"npm run css:types:watch\"",
    "dev:next": "next dev",
    "prebuild": "npm run css:types",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mcp": "npx tsx mcp/server.ts",
    "css:types": "npx tcm -p \"src/**/*.module.css\" . --camelCase",
    "css:types:watch": "npx tcm -w -p \"src/**/*.module.css\" . --camelCase",
    "data:pull": "node scripts/pull-data.mjs",
    "data:pull:salon": "node scripts/pull-data.mjs --dest=D:/Workspaces/local/SavingsTracker/data"
  },
  "dependencies": {
    "next": "14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "xirr": "^1.1.0",
    "yahoo-finance2": "^3.13.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.0.0",
    "tsx": "^4.23.12",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.0.0",
    "zod": "^4.4.3"
  }
}
